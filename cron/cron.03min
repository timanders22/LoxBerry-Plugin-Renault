#!/bin/bash
# Renault - Datenabruf alle drei Minuten.
#
# REPLACELBPHTMLAUTHDIR wird vom LoxBerry-Installer durch den echten
# Pluginordner ersetzt. Das cd ist wichtig: abruf.php liest und schreibt
# seine Dateien (config.php, session, database.csv, renault.log) ueber
# relative Pfade.
cd REPLACELBPHTMLAUTHDIR && php abruf.php cron
